{
  "name": "gesture-synth",
  "version": "1.0.0",
  "private": true,
  "description": "A camera-based musical instrument that turns hand gestures into chords, tone, and expression.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Eric Wei",
  "homepage": "https://github.com/therebelrobot/gesture-synth-plus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therebelrobot/gesture-synth-plus.git"
  },
  "bugs": {
    "url": "https://github.com/therebelrobot/gesture-synth-plus/issues"
  },
  "keywords": [
    "webcam",
    "hand-tracking",
    "mediapipe",
    "web-audio",
    "synthesizer",
    "gesture-control",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "docker:build": "docker build -t ghcr.io/therebelrobot/gesture-synth-plus:local .",
    "docker:push": "docker buildx build --platform linux/amd64,linux/arm64 -t ghcr.io/therebelrobot/gesture-synth-plus:latest --push .",
    "release:patch": "npm version patch -m \"chore: release v%s\" && git push && git push --tags",
    "release:minor": "npm version minor -m \"chore: release v%s\" && git push && git push --tags",
    "release:major": "npm version major -m \"chore: release v%s\" && git push && git push --tags"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.1.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35"
  }
}
